# Task set for verified-analyst. Gold = result of gold_sql on the synthetic dataset.
{"id": "L01", "category": "lookup", "question": "How many users signed up in total?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(*) FROM users"}
{"id": "L02", "category": "lookup", "question": "How many users are on Android?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(*) FROM users WHERE platform = 'android'"}
{"id": "L03", "category": "lookup", "question": "How many subscriptions are currently active?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(*) FROM subscriptions WHERE status = 'active'"}
{"id": "L04", "category": "lookup", "question": "How many distinct countries do our users come from?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(DISTINCT country) FROM users"}
{"id": "L05", "category": "lookup", "question": "How many payments have failed?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(*) FROM payments WHERE status = 'failed'"}
{"id": "A01", "category": "aggregate", "question": "What is the total revenue in USD from payments with status succeeded? Round to 2 decimals.", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT ROUND(SUM(amount_usd), 2) FROM payments WHERE status = 'succeeded'"}
{"id": "A02", "category": "aggregate", "question": "Which acquisition channel brought in the most users? Give the channel name.", "expected_status": "answered", "answer_type": "label", "gold_sql": "SELECT channel FROM users GROUP BY channel ORDER BY COUNT(*) DESC LIMIT 1"}
{"id": "A03", "category": "aggregate", "question": "What percentage of users are on iOS? Round to 1 decimal.", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT ROUND(100.0 * AVG(CASE WHEN platform = 'ios' THEN 1 ELSE 0 END), 1) FROM users"}
{"id": "A04", "category": "aggregate", "question": "How many users are there per platform? Return platform and user count.", "expected_status": "answered", "answer_type": "table", "gold_sql": "SELECT platform, COUNT(*) FROM users GROUP BY platform"}
{"id": "A05", "category": "aggregate", "question": "On average, how many payments (of any status) does a subscription that has at least one payment have? Round to 2 decimals.", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT ROUND(AVG(c), 2) FROM (SELECT subscription_id, COUNT(*) c FROM payments GROUP BY subscription_id)"}
{"id": "A06", "category": "aggregate", "question": "What percentage of all payments were refunded? Round to 2 decimals.", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT ROUND(100.0 * AVG(CASE WHEN status = 'refunded' THEN 1 ELSE 0 END), 2) FROM payments"}
{"id": "J01", "category": "join", "question": "What is the trial-to-paid conversion rate for iOS users, as a percentage rounded to 1 decimal? Ignore subscriptions that are still trialing.", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT ROUND(100.0 * AVG(CASE WHEN s.converted THEN 1 ELSE 0 END), 1) FROM subscriptions s JOIN users u USING (user_id) WHERE u.platform = 'ios' AND s.status <> 'trialing'"}
{"id": "J02", "category": "join", "question": "Return the trial-to-paid conversion rate (percentage rounded to 1 decimal) for each platform. Ignore subscriptions that are still trialing. Return platform and rate.", "expected_status": "answered", "answer_type": "table", "gold_sql": "SELECT u.platform, ROUND(100.0 * AVG(CASE WHEN s.converted THEN 1 ELSE 0 END), 1) FROM subscriptions s JOIN users u USING (user_id) WHERE s.status <> 'trialing' GROUP BY u.platform"}
{"id": "J03", "category": "join", "question": "Which country generated the most revenue from payments with status succeeded? Give the country code.", "expected_status": "answered", "answer_type": "label", "gold_sql": "SELECT u.country FROM payments p JOIN subscriptions s USING (subscription_id) JOIN users u USING (user_id) WHERE p.status = 'succeeded' GROUP BY u.country ORDER BY SUM(p.amount_usd) DESC LIMIT 1"}
{"id": "J04", "category": "join", "question": "How many subscriptions held by Android users ended because of a billing_error?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(*) FROM subscriptions s JOIN users u USING (user_id) WHERE u.platform = 'android' AND s.end_reason = 'billing_error'"}
{"id": "J05", "category": "join", "question": "What is the revenue from succeeded payments for each plan? Round to 2 decimals. Return plan and revenue.", "expected_status": "answered", "answer_type": "table", "gold_sql": "SELECT s.plan, ROUND(SUM(p.amount_usd), 2) FROM payments p JOIN subscriptions s USING (subscription_id) WHERE p.status = 'succeeded' GROUP BY s.plan"}
{"id": "J06", "category": "join", "question": "Among subscriptions whose trial has ended (status is not trialing), which acquisition channel has the highest trial-to-paid conversion rate? Give the channel name.", "expected_status": "answered", "answer_type": "label", "gold_sql": "SELECT u.channel FROM subscriptions s JOIN users u USING (user_id) WHERE s.status <> 'trialing' GROUP BY u.channel ORDER BY AVG(CASE WHEN s.converted THEN 1 ELSE 0 END) DESC LIMIT 1"}
{"id": "T01", "category": "time", "question": "How many users signed up in 2025?", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT COUNT(*) FROM users WHERE signup_date >= DATE '2025-01-01' AND signup_date < DATE '2026-01-01'"}
{"id": "T02", "category": "time", "question": "What was the total revenue from succeeded payments in March 2025? Round to 2 decimals.", "expected_status": "answered", "answer_type": "scalar", "gold_sql": "SELECT ROUND(SUM(amount_usd), 2) FROM payments WHERE status = 'succeeded' AND paid_on >= DATE '2025-03-01' AND paid_on < DATE '2025-04-01'"}
{"id": "T03", "category": "time", "question": "How many users signed up in each of January, February and March 2025? Return the month as YYYY-MM and the count.", "expected_status": "answered", "answer_type": "table", "gold_sql": "SELECT strftime(signup_date, '%Y-%m'), COUNT(*) FROM users WHERE signup_date >= DATE '2025-01-01' AND signup_date < DATE '2025-04-01' GROUP BY 1"}
{"id": "T04", "category": "time", "question": "In which month of 2025 did the most subscriptions end? Answer as YYYY-MM.", "expected_status": "answered", "answer_type": "label", "gold_sql": "SELECT strftime(ended_on, '%Y-%m') FROM subscriptions WHERE ended_on >= DATE '2025-01-01' AND ended_on < DATE '2026-01-01' GROUP BY 1 ORDER BY COUNT(*) DESC LIMIT 1"}
